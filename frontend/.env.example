GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.6-flash
# "low" (~100 tokens/sec of video) | "medium" | "high" | "ultra_high"
GEMINI_MEDIA_RESOLUTION=low
MAX_UPLOAD_MB=500

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_public_key
CLERK_SECRET_KEY=sk_test_secret

# Matches docker-compose.yml + .dockerenv (host port 5434)
DATABASE_URL=postgresql://pguser:pgpass@localhost:5434/testdb

UPSTASH_REDIS_REST_URL=url
UPSTASH_REDIS_REST_TOKEN=secret_token
